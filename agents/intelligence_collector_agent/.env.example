# Machine-specific overrides for config/intelligence_collector.yaml.
# Copy to .env (gitignored). Env wins over yaml so local vs cloud does not dirty git.

# OpenClaw models registered on THIS host. Comma-separated fallbacks.
# OPENCLAW_AGENT_PRIMARY_MODEL=deepseek/deepseek-v4-flash
# OPENCLAW_AGENT_FALLBACK_MODELS=custom-api-siliconflow-cn/Pro/zai-org/GLM-5.1

# Interpreter used to spawn MIC / stock_data_collector CLIs.
# Needed when the OpenClaw worker does not inherit the mydev venv.
# INTEL_AGENT_PYTHON=/home/yu/.venvs/mydev/bin/python

# Optional: explicit path to this file if the yaml is not under config/.
# INTEL_AGENT_ENV_FILE=/abs/path/to/agents/intelligence_collector_agent/.env
