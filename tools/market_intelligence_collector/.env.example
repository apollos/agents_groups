# MIC environment variables (copy to .env and fill in)

# --- Model providers (OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=
OPENCLAW_GATEWAY_TOKEN=
# OpenClaw gateway host/port. Overrides model_registry.yaml openclaw_research.endpoint
# so local WSL vs cloud does not require a yaml (git) change. Include the /v1 suffix.
# Example local: http://127.0.0.1:18789/v1
OPENCLAW_GATEWAY_BASE_URL=http://127.0.0.1:18789/v1
# Optional override of the dedicated MIC extraction agent route. The checked-in
# default is openclaw/mic-extract; do not reuse OPENCLAW_REQUEST_MODEL from
# unrelated OpenClaw clients.
MIC_OPENCLAW_REQUEST_MODEL=
# Vision (text+image) model on the OpenClaw side, sent as the x-openclaw-model
# header for image transcription calls only (scanned PDFs / page screenshots).
# Example: custom-api-siliconflow-cn/Pro/moonshotai/Kimi-K2.6
OPENCLAW_VISION_MODEL=

# --- Search providers ---
# Legacy optional provider only. The formal default is browser_local, so this
# key is not needed for ordinary collection.
SERPAPI_API_KEY=
# Legacy optional provider only; not a formal browser-route fallback.
TAVILY_API_KEY=
# Legacy optional provider only; formal collection does not require this service.
SEARXNG_BASE_URL=http://localhost:8888

# --- Storage ---
# Default is local SQLite. For PostgreSQL use e.g.
#   postgresql+psycopg://user:pass@localhost:5432/mic
MIC_DATABASE_URL=sqlite:///mic.db

# --- Runtime ---
# Formal collection never falls back to mock. Offline tests/demos must set true
# explicitly together with an explicit mock search configuration.
MIC_ALLOW_MOCK=false

# --- Config location ---
# Configuration priority is explicit config_dir, then MIC_CONFIG_DIR, then the
# repository config/. Point CLI and Agent subprocesses at a deployment config
# directory only when every required MIC YAML is present there:
# MIC_CONFIG_DIR=/path/to/workspace/tools/market_intelligence_collector/config

# --- Default local browser search route (search_providers.active: browser_local) ---
# Dedicated Edge profile for MIC only (never your daily browser profile). Keep it
# OUTSIDE the repository; MIC creates/chmods it 0700. Required for formal runs.
MIC_BROWSER_PROFILE_DIR=/path/outside/repository/mic-edge
# Only when browser_runtime.session_fallback.enabled is true (user-authorised cookies):
# MIC_BROWSER_CREDENTIAL_DIR=/path/to/workspace/browser/credentials
# Optional: where run logs go. Supervised Agent runs default to <run_dir>/logs.
# MIC_LOG_DIR=/path/to/workspace/logs/mic
