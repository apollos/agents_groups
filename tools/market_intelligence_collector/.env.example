# MIC environment variables (copy to .env and fill in)

# --- Model providers (OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=
OPENCLAW_GATEWAY_TOKEN=
# OpenClaw gateway host/port. Overrides model_registry.yaml openclaw_research.endpoint
# so local WSL vs cloud does not require a yaml (git) change. Include the /v1 suffix.
# Example local: http://127.0.0.1:18789/v1
OPENCLAW_GATEWAY_BASE_URL=http://127.0.0.1:18789/v1
# Agent route name sent as the JSON "model" field (yaml fallback: openclaw/research).
OPENCLAW_REQUEST_MODEL=openclaw/research
# Vision (text+image) model on the OpenClaw side, sent as the x-openclaw-model
# header for image transcription calls only (scanned PDFs / page screenshots).
# Example: custom-api-siliconflow-cn/Pro/moonshotai/Kimi-K2.6
OPENCLAW_VISION_MODEL=

# --- Search providers ---
# One key serves all serpapi_* providers (baidu/google/bing engines); leave
# empty to use the built-in mock provider. (The native Bing Search API was
# retired by Microsoft in 2025, so there is no separate Bing key.)
SERPAPI_API_KEY=
# Tavily search API (https://tavily.com, free tier 1000 calls/month).
# Used by the "tavily" provider (default rescue fallback).
TAVILY_API_KEY=
# Self-hosted SearXNG instance (see searxng/docker-compose.yml).
SEARXNG_BASE_URL=http://localhost:8888

# --- Storage ---
# Default is local SQLite. For PostgreSQL use e.g.
#   postgresql+psycopg://user:pass@localhost:5432/mic
MIC_DATABASE_URL=sqlite:///mic.db

# --- Runtime ---
# If true (default), missing API keys cause adapters to fall back to a deterministic
# mock so the pipeline can be demoed end-to-end without external services.
MIC_ALLOW_MOCK=true

# --- Config location ---
# `mic` CLI commands (browser doctor/setup, search probe, ...) read the repo config/ by
# default. Point them at a deployment config dir instead (the Agent passes its own
# config_dir explicitly and ignores this):
# MIC_CONFIG_DIR=/path/to/workspace/tools/market_intelligence_collector/config

# --- Local browser search route (search_providers.active: browser_local) ---
# Dedicated Edge profile for MIC only (never your daily browser profile). Keep it
# OUTSIDE the repository; MIC creates/chmods it 0700. Required when
# config/browser_runtime.yaml has enabled: true.
# MIC_BROWSER_PROFILE_DIR=/path/to/workspace/browser/profiles/mic-edge
# Only when browser_runtime.session_fallback.enabled is true (user-authorised cookies):
# MIC_BROWSER_CREDENTIAL_DIR=/path/to/workspace/browser/credentials
# Optional: where run logs go. Supervised Agent runs default to <run_dir>/logs.
# MIC_LOG_DIR=/path/to/workspace/logs/mic
